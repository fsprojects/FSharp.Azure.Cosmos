<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SDK's parser of Cosmos DB SQL as an oracle for the tests: SdkGrammar.parse reads query text with the generated
    parser of FSharp.Azure.Cosmos.Sql.Grammar.Generated and gives the syntax tree of FSharp.Azure.Cosmos.Sql.

    A project of its own, and one that must never reference Microsoft.Azure.Cosmos: the SDK assembly has internal
    types named sqlParser and sqlLexer too, and in a project that references it F# resolves those names to the SDK's
    types, which it cannot use, instead of the generated ones.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(AssemblyBaseName).Sql.Grammar</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      A library that test projects reference, not a test application: tests/Directory.Build.props marks every project
      under tests/ as a test project, so this one opts out explicitly. It needs no test framework at all.
    -->
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SdkGrammar.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cosmos.Sql\FSharp.Azure.Cosmos.Sql.fsproj" />
    <ProjectReference Include="..\Cosmos.Sql.Grammar.Generated\FSharp.Azure.Cosmos.Sql.Grammar.Generated.csproj" />
  </ItemGroup>

</Project>
