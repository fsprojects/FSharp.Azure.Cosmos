<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(AssemblyBaseName).Tests</AssemblyName>

    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="testconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestCategories.fs" />
    <Compile Include="TestAssembly.fs" />
    <Compile Include="OperationTestInfrastructure.fs" />
    <Compile Include="CosmosNameTests.fs" />
    <Compile Include="ResponseMessageTests.fs" />
    <Compile Include="IcedTasksProbeTests.fs" />
    <Compile Include="ValueCollectionsTests.fs" />
    <Compile Include="QuerySemanticsTests.fs" />
    <Compile Include="TestInfrastructure\BaselineTests.fs" />
    <Compile Include="TestInfrastructure\ContainerSetTests.fs" />
    <Compile Include="TestInfrastructure\DatabaseIdentifierTests.fs" />
    <Compile Include="TestInfrastructure\LeftoverSweepTests.fs" />
    <Compile Include="TestInfrastructure\PartitionBudgetTests.fs" />
    <Compile Include="Scenarios\SingleItemScenario.fs" />
    <Compile Include="Scenarios\MultipleItemsScenario.fs" />
    <Compile Include="Scenarios\DurationsScenario.fs" />
    <Compile Include="Operations\CreateOperationTests.fs" />
    <Compile Include="Operations\ReadOperationTests.fs" />
    <Compile Include="Operations\UpsertOperationTests.fs" />
    <Compile Include="Operations\ReplaceOperationTests.fs" />
    <Compile Include="Operations\PatchOperationTests.fs" />
    <Compile Include="Operations\DeleteOperationTests.fs" />
    <Compile Include="Operations\ReadManyOperationTests.fs" />
    <!-- Last of the folder, as it was last of the project: its private record BuilderTestItem has the labels id and partitionKey of TestItem, and F# resolves a record expression to the latest record that has the label. Earlier in the list it takes the type of the record expressions of the tests after it. -->
    <Compile Include="Operations\BuilderUnitTests.fs" />
    <Compile Include="Extensions\IterationExtensionsUnitTests.fs" />
    <Compile Include="Extensions\ReadExtensionsTests.fs" />
    <Compile Include="Extensions\IterationExtensionsTests.fs" />
    <Compile Include="Json\TimeSpanTicksConverterTests.fs" />
    <Compile Include="Json\TimeSpanTicksConverterIntegrationTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hedgehog" />
    <PackageReference Include="Hedgehog.MSTest" />
    <!-- Referenced directly although the library references it too: the probe tests use IcedTasks themselves and gate which of its builders library code may use, so they must not depend on what the library happens to reference. -->
    <PackageReference Include="IcedTasks" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="Unquote" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cosmos\FSharp.Azure.Cosmos.fsproj" />
  </ItemGroup>

</Project>
