<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(AssemblyBaseName).Tests</AssemblyName>

    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="testconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestCategories.fs" />
    <Compile Include="TestAssembly.fs" />
    <Compile Include="IcedTasksProbeTests.fs" />
    <Compile Include="IterationExtensionsUnitTests.fs" />
    <Compile Include="ValueCollectionsTests.fs" />
    <Compile Include="CosmosNameTests.fs" />
    <Compile Include="ResponseMessageTests.fs" />
    <Compile Include="DatabaseIdentifierTests.fs" />
    <Compile Include="PartitionBudgetTests.fs" />
    <Compile Include="LeftoverSweepTests.fs" />
    <Compile Include="OperationTestInfrastructure.fs" />
    <Compile Include="CreateOperationTests.fs" />
    <Compile Include="ReadOperationTests.fs" />
    <Compile Include="UpsertOperationTests.fs" />
    <Compile Include="ReplaceOperationTests.fs" />
    <Compile Include="PatchOperationTests.fs" />
    <Compile Include="DeleteOperationTests.fs" />
    <Compile Include="ReadManyOperationTests.fs" />
    <Compile Include="ReadExtensionsTests.fs" />
    <Compile Include="IterationExtensionsTests.fs" />
    <Compile Include="BuilderUnitTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced directly although the library references it too: the probe tests use IcedTasks themselves and gate which of its builders library code may use, so they must not depend on what the library happens to reference. -->
    <PackageReference Include="IcedTasks" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="Unquote" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cosmos\FSharp.Azure.Cosmos.fsproj" />
  </ItemGroup>

</Project>
