<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of FSharp.Azure.Cosmos.Sql; none of them needs the Cosmos DB Emulator. IsTestProject and IsPackable come
    from tests/Directory.Build.props, which also references the shared test infrastructure.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(AssemblyBaseName).Sql.Tests</AssemblyName>

    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="testconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestCategories.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="SyntaxTests.fs" />
    <Compile Include="EquatableArrayTests.fs" />
    <Compile Include="EquatableArrayModuleTests.fs" />
    <Compile Include="ImmutableArrayPatternsTests.fs" />
    <Compile Include="PrinterTests.fs" />
    <Compile Include="InlineTests.fs" />
    <Compile Include="CatalogTests.fs" />
    <Compile Include="ValidatorTests.fs" />
    <Compile Include="GeneratorHelperTests.fs" />
    <Compile Include="SdkGrammarTests.fs" />
    <Compile Include="PrinterLawsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hedgehog" />
    <PackageReference Include="Hedgehog.MSTest" />
    <!-- Only for the catalog test that compares the catalog with the function names of the SDK version in use -->
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cosmos.Sql\FSharp.Azure.Cosmos.Sql.fsproj" />
    <ProjectReference Include="..\Cosmos.Sql.Grammar\FSharp.Azure.Cosmos.Sql.Grammar.fsproj" />
    <ProjectReference Include="..\Cosmos.Sql.Hedgehog\FSharp.Azure.Cosmos.Sql.Hedgehog.fsproj" />
  </ItemGroup>

</Project>
