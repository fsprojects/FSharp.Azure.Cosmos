<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      Every test project shares the test infrastructure (fixtures, emulator budget, assertion helpers). Excluded are
      the infrastructure project itself, because a project cannot reference itself; the generator library, which only
      generates values and never touches a database; and the project of the SDK's generated parser, which must not
      reference the SDK.
    -->
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'FSharp.Azure.Cosmos.Tests.Infrastructure'
                          AND '$(MSBuildProjectName)' != 'FSharp.Azure.Cosmos.Sql.Grammar.Generated'
                          AND '$(MSBuildProjectName)' != 'FSharp.Azure.Cosmos.Sql.Hedgehog'">
        <ProjectReference Include="$(MSBuildThisFileDirectory)Cosmos.Tests.Infrastructure/FSharp.Azure.Cosmos.Tests.Infrastructure.fsproj" />
    </ItemGroup>
</Project>
